/dts-v1/;
/plugin/;

#include "vienna-wrd-no-cam.dtsi"
#include "vienna-pmw6100-v1.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Vienna WRD No Camera PMW6100 V1";
	compatible = "qcom,vienna-wrd", "qcom,vienna", "qcom,wrd";
	qcom,board-id = <0x1002d 0x01>;
	qcom,pmic-id = <0x10064 0x0 0x0 0x0>;
};
