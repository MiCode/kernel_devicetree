&tlmm {
	rfcable_control: rfcable_control {
		mux {
			pins = "gpio97";
			function = "gpio";
		};
		config {
			pins = "gpio97";
			drive-strength = <2>;
			input-enable;
			bias-pull-up;
		};
	};
};

&soc {
	rfcable_detect {
		compatible = "lxcom,rfcable-detect";
		label = "lx_rfcable";
		target-gpio = <&tlmm 97 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "rf_luxcable_det";
		pinctrl-0 = <&rfcable_control>;
	};
};
