&strategy_fg {
	status = "ok";
	fg_type = <0>;
	report-full-rsoc = <9700>;
	soc-proportion = <98>;
	soc-proportion-c = <97>;
	support-pnc;
	support-vpack-low-shutdown;
	has_global_shutdown_para;
	has_second_supplier_para;
	vcutoff_shutdown_delay = <2850>;
