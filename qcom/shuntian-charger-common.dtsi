&soc {
	ut_test {
		compatible = "charge,ut-test";
		status = "ok";

		mi,lossless_rechg;
		mi,cycle_volt = "0,100,4150,4300,4530,4560,100,300,4120,4270,4500,4540,300,800,4120,4270,4500,4520,800,10000,4100,4250,4480,4500";
		mi,cycle_step_curr = "0,100,12400,11858,10780,8624,100,300,12400,11265,10241,8624,300,800,12400,10672,9702,7762,800,10000,9920,9486,8624,6899";
		mi,temp_term_curr = "18,35,2369,35,40,2813,40,48,3237";
		mi,thermal = "12400,10000,8500,7600,6600,5900,5200,4700,4200,3400,2800,2400,1900,1400,1100,900";
	};
};
