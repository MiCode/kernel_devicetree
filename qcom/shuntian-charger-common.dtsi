&mca_strategy_buckchg_class {
	status = "ok";
	ffc_temp_low = <18>;
	ffc_temp_high = <48>;
	allow_start_ffc_batt_soc_para =
		"300", "90",
		"800", "85",
		"1200", "80",
		"65535", "70";
	support_reverse_quick_charge;
	support_sw_aicl;
	support_revchg_screenon;
};

&mca_strategy_quick_charge {
	status = "ok";
	cp_type = <1>;
	min_vbat = <3450>;
	max_vbat = <4560>;

	/* cyclecount, vbat_diff, soc_threshold */
	enable_cp_para =
		"300", "70", "90",
		"800", "90", "85",
		"1200", "200", "80",
		"65535", "250", "70";
	div_delta_volt = <300 300 600>;
	div_single_curr = <4500 11000 15600>;
	div_max_curr = <5000 12400 15600>;
	multi_ibus_th = <2000 1700 600>;
	support_mode = <3>;
	support_batt_safe_lvl;
	adapter_ibus_compensation = <0>;
	pps_taper_vol_hys = <8>;


	/* usb_vendor_id, product_vdo, max_power, en_cp, max_vol, max_curr */
	third_pps_charger_para =
		"0x2E87", "0x00000000", "105", "1", "20000", "2000", // 绿联140w三口 21V/5A 105W
		"0x2B01", "0x0000A819", "55",  "1", "20000", "3000", // PB2050ZM三口输出充电宝 11V/5A 55W
		"0x2B01", "0x0000A819", "105", "1", "20000", "3500", // 车充WCJ05CCZM 21V/5A 105W
		"0X22D9", "0x0000731A", "67",  "1", "20000", "2000"; // 德赛西威/远峰理想67w 11V/6.1A 67W

	/* volt_ratio, cur_gap, vbat_gap, vstep_ratio */
	vstep_para =
		"1", "800", "2000", "0", "2",
		"2", "800", "4000", "0", "10",
		"2", "800", "3000", "0", "8",
		"2", "800", "2000", "0", "7",
		"2", "800", "1000", "0", "4",
		"2", "800", "600", "0", "2";

	batt_para =
		"0", "coslight", "batt_para_cos";
	/* temp_low, temp_high, low_hys, high_hys, max_curr, normal_para, ffc_para, normal_stage, ffc_stage */
	batt_para_cos =
		"-65535", "8", "0", "2", "0", "null", "null", "null", "null",
		"8", "13", "0", "1", "4491", "normal_para_8_13_cos", "null", "null", "null",
		"13", "18", "0", "1", "7186", "normal_para_13_18_cos", "null", "null", "null",
		"18", "35", "1", "0", "12400", "normal_para_18_35_cos", "ffc_para_18_35_cos", "null", "ffc_stage_18_35_cos",
		"35", "40", "1", "0", "12400", "normal_para_35_40_cos", "ffc_para_35_40_cos", "null", "ffc_stage_35_40_cos",
		"40", "48", "1", "0", "12400", "normal_para_40_48_cos", "ffc_para_40_48_cos", "null", "ffc_stage_40_48_cos",
		"48", "65535", "2", "0", "0", "null", "null", "null", "null";

	/* volt, curr_max, curr_min */
	normal_para_8_13_cos =
		"4523", "4491", "674";

	normal_para_13_18_cos =
		"4523", "7186", "674";

	normal_para_18_35_cos =
		"4150", "12400", "8624",
		"4503", "8624", "674";

	ffc_para_18_35_cos =
		"4150", "12400", "11858",
		"4295", "11858", "10780",
		"4525", "10780", "8624",
		"4553", "8624", "2369";
	ffc_stage_18_35_cos = <0 1 0 0 0 0 0 0>;

	normal_para_35_40_cos =
		"4150", "12400", "8624",
		"4503", "8624", "674";
	ffc_para_35_40_cos =
		"4150", "12400", "11858",
		"4295", "11858", "10780",
		"4525", "10780", "8624",
		"4553", "8624", "2813";
	ffc_stage_35_40_cos = <0 1 0 0 0 0 0 0>;

	normal_para_40_48_cos =
		"4150", "12400", "8624",
		"4503", "8624", "674";
	ffc_para_40_48_cos =
		"4150", "12400", "11858",
		"4295", "11858", "10780",
		"4525", "10780", "8624",
		"4553", "8624", "3237";
	ffc_stage_40_48_cos = <0 1 0 0 0 0 0 0>;
};

