#include "mca.dtsi"

&tlmm {
	charger_cp_int_master: charger_cp_int_master {
		mux {
			pins = "gpio83";
			function = "gpio";
		};
		config {
			pins = "gpio83";
			drive-strength = <2>;   /* 2 mA */
			bias-disable;
		};
	};

	charger_cp_int_slave: charger_cp_int_slave {
		mux {
			pins = "gpio61";
			function = "gpio";
		};
		config {
			pins = "gpio61";
			drive-strength = <2>;   /* 2 mA */
			bias-disable;
		};
	};

	cp_master_i2c_sda_active: cp_master_i2c_sda_active {
		mux {
			pins = "gpio68";
			function = "qup3_se1_l0";
		};
		config {
			pins = "gpio68";
			drive-strength = <2>;   /* 2 mA */
			bias-disable;
		};
	};

	cp_master_i2c_scl_active: cp_master_i2c_scl_active {
		mux {
			pins = "gpio69";
			function = "qup3_se1_l1";
		};
		config {
			pins = "gpio69";
			drive-strength = <2>;   /* 2 mA */
			bias-disable;
		};
	};

	cp_master_i2c_sleep: cp_master_i2c_sleep {
		mux {
			pins = "gpio68", "gpio69";
			function = "gpio";
		};

		config {
			pins = "gpio68", "gpio69";
			drive-strength = <2>;
		};
	};

	cp_slave_i2c_sda_active: cp_slave_i2c_sda_active {
		mux {
			pins = "gpio76";
			function = "qup3_se3_l0";
		};
		config {
			pins = "gpio76";
			drive-strength = <2>;   /* 2 mA */
			bias-disable;
		};
	};

	cp_slave_i2c_scl_active: cp_slave_i2c_scl_active {
		mux {
			pins = "gpio77";
			function = "qup3_se3_l1";
		};
		config {
			pins = "gpio77";
			drive-strength = <2>;   /* 2 mA */
			bias-disable;
		};
	};

	cp_slave_i2c_sleep: cp_slave_i2c_sleep {
		mux {
			pins = "gpio76", "gpio77";
			function = "gpio";
		};

		config {
			pins = "gpio76", "gpio77";
			drive-strength = <2>;
		};
	};

	wls_int_default: wls_int_default {
		mux {
			pins = "gpio47";
			function = "gpio";
		};
		config {
			pins = "gpio47";
			drive-strength = <2>;   /* 2 mA */
			bias-pull-up;
			qcom,apps;
		};
	};

	up_hall_n_int_default: up_hall_n_int_default {
		mux {
			pins = "gpio201";
			function = "gpio";
		};
		config {
			pins = "gpio201";
			drive-strength = <2>;
			input-enable;
			bias-pull-up;
			qcom,apps;
		};
	};

	up_hall_s_int_default: up_hall_s_int_default {
		mux {
			pins = "gpio162";
			function = "gpio";
		};
		config {
			pins = "gpio162";
			drive-strength = <2>;
			input-enable;
			bias-pull-up;
			qcom,apps;
		};
	};

	down_hall_n_int_default: down_hall_n_int_default {
		mux {
			pins = "gpio108";
			function = "gpio";
		};
		config {
			pins = "gpio108";
			drive-strength = <2>;
			input-enable;
			bias-pull-up;
			qcom,apps;
		};
	};

	down_hall_s_int_default: down_hall_s_int_default {
		mux {
			pins = "gpio112";
			function = "gpio";
		};
		config {
			pins = "gpio112";
			drive-strength = <2>;
			input-enable;
			bias-pull-up;
			qcom,apps;
		};
	};

	lp_nen_default: lp_nen_default {
		mux {
			pins = "gpio54";
			function = "gpio";
		};
		config {
			pins = "gpio54";
			drive-strength = <2>;
			output-high;
			qcom,apps;
		};
	};

	hall_ppe_n_int_default: hall_ppe_int_default {
		mux {
			pins = "gpio11";
			function = "gpio";
		};
		config {
			pins = "gpio11";
			drive-strength = <2>;
			input-enable;
			bias-pull-up;
			qcom,apps;
		};
	};

	hall_ppe_s_int_default: hall_ppe_s_int_default {
		mux {
			pins = "gpio15";
			function = "gpio";
		};
		config {
			pins = "gpio15";
			drive-strength = <2>;
			input-enable;
			bias-pull-up;
			qcom,apps;
		};
	};

};

&qupv3_se17_i2c {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&cp_master_i2c_sda_active>, <&cp_master_i2c_scl_active>;
	pinctrl-1 = <&cp_master_i2c_sleep>;

	bq27z561_standlone@55 {
		compatible = "ti,bq27z561_master";
		ic_role = <0>;
		reg = <0x55>;
		unseal_key = /bits/ 8 <0x64 0x8d 0x17 0x25>;
		bq,charge-full-design = <11000>;
		soh_th = <92>;
		cycle_th = <400>;
		cycle_step = <50>;
		resistance-id = <100000>;
		support-batt-sn-v2026;
		status = "ok";
	};

	sc8531_master@61 {
		compatible = "sc8531_master";
		status = "ok";
		ic_role = <0>;
		reg = <0x61>;
		cp-int= <&tlmm 83 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&charger_cp_int_master>;
		bat-ovp-threshold = <5000>;
		bus-ovp-threshold = <13000 6000>;
		bus-ocp-threshold = <4000 4000>;
		usb-ovp-threshold = <14000 7500>;
	};
};

&qupv3_se19_i2c {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&cp_slave_i2c_sda_active>, <&cp_slave_i2c_scl_active>;
	pinctrl-1 = <&cp_slave_i2c_sleep>;

	sc8531_slave@61 {
		compatible = "sc8531_slave";
		status = "ok";
		ic_role = <1>;
		reg = <0x61>;
		cp-int= <&tlmm 61 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&charger_cp_int_slave>;
		bat-ovp-threshold = <5000>;
		bus-ovp-threshold = <13000 6000>;
		bus-ocp-threshold = <4000 4000>;
		usb-ovp-threshold = <14000 7500>;
	};
};

&qupv3_se0_i2c {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;

	nu1677@34 {
		compatible = "fuda,nu1677";
		reg = <0x34>;
		rx_role = <0>;
		project_vendor = <6>;
		fw_version_index = <0>;
		pinctrl-names =
			"wls_int_pull_up", "up_hall_n_int_pull_up", "up_hall_s_int_pull_up", "down_hall_n_int_pull_up",
			"down_hall_s_int_pull_up", "lp_nen_pull_up", "hall_ppe_n_int_pull_up", "hall_ppe_s_int_pull_up";
		pinctrl-0 = <&wls_int_default>;
		pinctrl-1 = <&up_hall_n_int_default>;
		pinctrl-2 = <&up_hall_s_int_default>;
		pinctrl-3 = <&down_hall_n_int_default>;
		pinctrl-4 = <&down_hall_s_int_default>;
		pinctrl-5 = <&lp_nen_default>;
		pinctrl-6 = <&hall_ppe_n_int_default>;
		pinctrl-7 = <&hall_ppe_s_int_default>;
		wl-int = <&tlmm 47 0x00>;
		up-hall-n-int = <&tlmm 201 0x00>;
		up-hall-s-int = <&tlmm 162 0x00>;
		down-hall-n-int = <&tlmm 108 0x00>;
		down-hall-s-int = <&tlmm 112 0x00>;
		lp-nen-gpio = <&tlmm 54 0x00>;
		hall-ppe-n-int = <&tlmm 11 0x00>;
		hall-ppe-s-int = <&tlmm 15 0x00>;
		reverse-txon-gpio = <&tlmm 99 0x00>;
		reverse-boost-gpio = <&tlmm 70 0x00>;
	};
};

&mca_adsp_glink {
	status = "ok";
};

&mca_bc12_class {
	status = "ok";
};

&mca_qcom_subpmic_proxy {
	status = "ok";
