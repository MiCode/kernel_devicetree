&tlmm {
	qupv3_se1_2uart_pins: qupv3_se1_2uart_pins {
		qupv3_se1_2uart_tx_active: qupv3_se1_2uart_tx_active {
			mux {
				pins = "gpio143";
				function = "qup2_se1_l2";
			};

			config {
				pins = "gpio143";
				drive-strength = <2>;
				bias-disable;
			};
		};

		qupv3_se1_2uart_rx_active: qupv3_se1_2uart_rx_active {
			mux {
				pins = "gpio144";
				function = "qup2_se1_l3";
			};

			config {
				pins = "gpio144";
				drive-strength = <2>;
				bias-disable;
			};
		};

		qupv3_se1_2uart_sleep: qupv3_se1_2uart_sleep {
			mux {
				pins = "gpio143", "gpio144";
				function = "gpio";
			};

			config {
				pins = "gpio143", "gpio144";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};

	ethernet1_default: ethernet1-default-state {
		ethernet1_mdc: ethernet1-mdc-pins {
			pins = "gpio49";
			function = "emac1_mdc";
			drive-strength = <16>;
			bias-pull-up;
		};

		ethernet1_mdio: ethernet1-mdio-pins {
			pins = "gpio50";
			function = "emac1_mdio";
			drive-strength = <16>;
			bias-pull-up;
		};

		ethernet1_pps_o_0: ethernet1-pps-o-0-pins {
			pins = "gpio41";
			function = "emac1_ptp";
		};

		ethernet1_pps_o_1: ethernet1-pps-o-1-pins {
			pins = "gpio42";
			function = "emac1_ptp";
		};

		ethernet1_pps_o_2: ethernet1-pps-o-2-pins {
			pins = "gpio43";
			function = "emac1_ptp";
		};

		ethernet1_pps_o_3: ethernet1-pps-o-3-pins {
			pins = "gpio44";
			function = "emac1_ptp";
		};
	};
};

