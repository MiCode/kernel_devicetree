	qcom,parf-debug-reg = <0x01b0 0x0024 0x0028 0x0224 0x0500
				0x04d0 0x04d4 0x03c0 0x0630 0x0230
				0x0000>;
	qcom,dbi-debug-reg = <0x0104 0x0110 0x0080 0x01f4 0x0730
