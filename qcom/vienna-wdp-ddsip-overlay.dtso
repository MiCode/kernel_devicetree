/dts-v1/;
/plugin/;

#include "vienna-wdp-ddsip.dtsi"
#include "vienna-pmw6100-v1.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Vienna WDP DDSIP PMW6100 V1";
	compatible = "qcom,vienna-wdp", "qcom,vienna", "qcom,wdp";
	qcom,board-id = <0x20024 0x0>;
	qcom,pmic-id = <0x10064 0x0 0x0 0x0>;
};
